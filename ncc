#!/usr/bin/env python3
import sys
import os

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from lexer import Lexer
from parser import Parser
from compiler import Compiler
from loader import loadProgram


def lexFile(path):
    tokens, err = Lexer(open(path).read()).createTokens()
    if err:
        print(err.as_string())
        sys.exit(1)
    for t in tokens:
        print(t)


def parseFile(path):
    tokens, err = Lexer(open(path).read()).createTokens()
    if err:
        print(err.as_string())
        sys.exit(1)
    try:
        print(Parser(tokens).parse().to_tree())
    except Exception as e:
        print(f"parse error: {e}")
        sys.exit(1)


def compileFile(path):
    try:
        ast = loadProgram(path)
    except Exception as e:
        print(f"error: {e}")
        sys.exit(1)
    try:
        print(Compiler(ast).compileNode(ast))
    except Exception as e:
        print(f"compile error: {e}")
        sys.exit(1)


def runFile(path):
    try:
        ast = loadProgram(path)
    except Exception as e:
        print(f"error: {e}")
        sys.exit(1)
    try:
        Compiler(ast).compile_and_run()
    except Exception as e:
        print(f"error: {e}")
        sys.exit(1)


def main():
    if len(sys.argv) < 3:
        print("usage: ncc <flag> <filepath>")
        print("  -l   lex")
        print("  -p   parse")
        print("  -c   compile")
        print("  -r   run")
        sys.exit(1)

    flag, path = sys.argv[1], sys.argv[2]

    if not os.path.exists(path):
        print(f"file not found: {path}")
        sys.exit(1)

    if flag == "-l":
        lexFile(path)
    elif flag == "-p":
        parseFile(path)
    elif flag == "-c":
        compileFile(path)
    elif flag == "-r":
        runFile(path)
    else:
        print(f"unknown flag: {flag}")
        sys.exit(1)


if __name__ == "__main__":
    main()
